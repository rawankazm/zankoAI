rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'rawankurdi181@gmail.com' ||
        request.auth.token.email.lower() == 'rawankazm@gmail.com'
      );
    }

    // Profile Images: Publicly viewable, only owner can upload their photo (max 5MB, image only)
    match /profile_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // VIP Payment Proof Receipts: Only owner and admin can view; max 10MB
    match /vip_receipts/{userId}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Academic Lecture Notes & PDFs: Publicly readable, only admin can upload/delete
    match /lectures/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Private Notes & Audio Records: Accessible only to owner
    match /user_notes/{userId}/{allPaths=**} {
      allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.size < 30 * 1024 * 1024;
    }

    // General app assets
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
