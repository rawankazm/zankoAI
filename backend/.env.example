# ==============================================================================
# ZankoAI Backend Environment Configuration Template
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=*

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis Configuration (DigitalOcean Managed Redis or Local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# External AI Provider API Keys
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Iraqi Payment Gateways
FIB_CLIENT_ID=your-fib-client-id
FIB_CLIENT_SECRET=your-fib-client-secret
FIB_BASE_URL=https://api.fib.iq
FASTPAY_MERCHANT_ID=your-fastpay-merchant-id
FASTPAY_PASSWORD=your-fastpay-password
ZAINCASH_MSISDN=your-zaincash-msisdn
ZAINCASH_SECRET=your-zaincash-secret

# WebPush / APNs Notification Credentials
NOTIFICATION_SECRET=zanko-notification-secret-2026
