# ==============================================================================
# ZankoAI Production Environment Configuration Template (.env.production)
# WARNING: NEVER commit the actual '.env.production' file to Git version control.
# Copy this file to '.env.production' on your production server and fill in secrets.
# ==============================================================================

# ─── 1. Server Environment ───
NODE_ENV=production
PORT=4000
API_PREFIX=/api

# ─── 2. CORS Allowed Origins (Comma-separated, NO WILDCARD in Production) ───
CORS_ORIGIN=https://zanko-admin.vercel.app,https://zankoai.com,https://www.zankoai.com

# ─── 3. Supabase PostgreSQL Infrastructure (Server-Side Secrets) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
SUPABASE_JWT_SECRET=your-production-supabase-jwt-secret

# ─── 4. Redis Cache & Queue Cluster (Internal Network) ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_a_long_random_64_character_hex_string_for_production
REDIS_TLS=false

# ─── 5. Rate Limiting Protection ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ─── 6. AI Providers & Model Configurations ───
DEFAULT_AI_PROVIDER=google
GEMINI_API_KEY=your-production-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-production-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-production-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ─── 7. Production Push Notifications (FCM / APNs) ───
NOTIFICATION_PROVIDER=fcm
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"zanko-ai-prod",...}

# ─── 8. Production Payment Gateways (FIB & ZainCash) ───
FIB_CLIENT_ID=your-fib-client-id
FIB_CLIENT_SECRET=your-fib-client-secret
ZAINCASH_MSISDN=9647800000000
ZAINCASH_MERCHANT_ID=your-zaincash-merchant-id
ZAINCASH_SECRET=your-zaincash-secret
