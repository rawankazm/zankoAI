rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'rawankurdi181@gmail.com' ||
          request.auth.token.email.lower() == 'rawankazm@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to ensure user is not blocked
    function isNotBlocked() {
      return !isAuth() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != "blocked" &&
          (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked") &&
          (!('isBlocked' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked != true)
        );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      
      // Prevent non-admins from self-assigning admin role or VIP status
      allow create: if isAuth() && isNotBlocked() && (
        isAdmin() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
          (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        )
      );

      allow update: if isAuth() && isNotBlocked() && (
        isAdmin() || (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVip', 'vipStatus'])
        )
      );

      allow delete: if isAdmin();

      match /notifications/{notifId} {
        allow read: if isAuth() && isNotBlocked() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuth() && isNotBlocked() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. VIP Requests
    match /vip_requests/{id} {
      allow read: if isAuth() && isNotBlocked() && (
        request.auth.uid == id ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuth() && isNotBlocked() && (
        request.auth.uid == id ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // 3. Config (Version config is public; sensitive configs are admin-writable & auth-readable)
    match /config/version_config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/payment_config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{document=**} {
      allow read: if isAuth() && isNotBlocked();
      allow write: if isAdmin();
    }

    // 4. Ads
    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Notifications & Broadcasts (Only admin can broadcast to all users)
    match /notifications/{id} {
      allow read: if true;
      allow create, write: if isAdmin();
    }

    match /notifications_queue/{id} {
      allow read, write: if isAdmin();
    }

    // Direct Messages (Personal messages between admin and specific student)
    match /direct_messages/{id} {
      allow read: if isAuth() && isNotBlocked() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuth() && isNotBlocked() &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if isAdmin() || (
        isAuth() && isNotBlocked() && request.auth.uid == resource.data.userId
      );
    }

    // 6. Security Alerts (Device limit & IP tracking alerts)
    match /security_alerts/{id} {
      allow create: if isAuth() && isNotBlocked();
      allow read, update, delete: if isAdmin();
    }

    // 7. User Feedback
    match /user_feedback/{id} {
      allow create: if isAuth() || true;
      allow read, write: if isAdmin();
    }

    match /feedback/{id} {
      allow create: if isAuth() || true;
      allow read, write: if isAdmin();
    }

    // 8. Public Leaderboard / Ranks
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isAuth() && isNotBlocked() && (request.auth.uid == userId || isAdmin());
    }

    // 9. ZankoLine Departments & Universities
    match /zankoline_departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Academic Departments & Courses
    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Study & Learning Collections (Private to each student)
    match /notes/{id} {
      allow read: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /schedule/{id} {
      allow read: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /flashcards/{id} {
      allow read: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reminders/{id} {
      allow read: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 12. Quizzes, Lectures, Announcements (Publicly readable, admin writable)
    match /quizzes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lectures/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isNotBlocked() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 13. User Feedback & Bug Reports
    match /user_feedback/{id} {
      allow create: if isAuth() && isNotBlocked();
      allow read, update, delete: if isAdmin();
    }

    // 14. App Configuration (App version, AI dynamic keys, payment numbers)
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
